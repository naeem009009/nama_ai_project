# Nama AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.

# Groq API key — required for AI responses
GROQ_API_KEY=gsk_your_groq_api_key_here

# Nama API key — used for X-API-Key header auth between services
NAMA_API_KEY=your_nama_api_key_here

# JWT secret — change to a strong random string in production
NAMA_JWT_SECRET=your_jwt_secret_here
